# Jetra Bot Token
# Get one from @BotFather in Jetra: /newbot  or  /token
# Then copy this file to ".env" and fill in your token:
#
#   cp .env.example .env
#   # then edit .env and replace YOUR_TOKEN_HERE
#
# Note: the .env file is git-ignored and must never be committed.

JETRA_TOKEN=YOUR_TOKEN_HERE
